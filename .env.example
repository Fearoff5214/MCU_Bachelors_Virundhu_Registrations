# Supabase pooled connection (Transaction pooler, port 6543) — used by the app on Vercel
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) — used by drizzle-kit migrations
DATABASE_URL_DIRECT="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma separated Google emails that become admin on first sign-in
ADMIN_EMAILS="you@gmail.com"

# Signs QR tokens — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=""

# Payments: "mock" until the real gateway is chosen
PAYMENT_PROVIDER="mock"

# Email
RESEND_API_KEY=""
EMAIL_FROM="BV Tickets <tickets@yourdomain.com>"

# Public URL of the site (used in emails)
APP_URL="http://localhost:3000"

# Protects /api/cron/* (Vercel sends it as Bearer token)
CRON_SECRET=""
